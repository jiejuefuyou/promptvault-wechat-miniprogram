<view class="container">
  <view class="header">
    <view class="title">我自己的 Prompt ✏️</view>
    <view class="subtitle muted">本机保存 {{customPrompts.length}} 条，可编辑、复制或删除</view>
  </view>

  <button class="btn add-btn" bindtap="onAddTap">+ 新建 Prompt</button>

  <view wx:if="{{customPrompts.length > 0}}" class="prompt-list">
    <view wx:for="{{customPrompts}}" wx:key="id" class="card prompt-item">
      <view bindtap="onPromptTap" data-id="{{item.id}}" aria-label="打开 {{item.title}}">
        <view class="prompt-title">{{item.title}}</view>
        <view class="prompt-preview muted">{{item.body}}</view>
        <view class="prompt-tags">
          <text wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this" class="tag">{{t}}</text>
        </view>
      </view>
      <view class="card-actions">
        <text class="edit-btn" bindtap="onEdit" data-id="{{item.id}}">编辑</text>
        <text class="del-btn" bindtap="onDelete" data-id="{{item.id}}">删除</text>
      </view>
    </view>
  </view>

  <view wx:elif="{{!showAddDialog}}" class="empty">
    <view class="empty-icon">📝</view>
    <view class="empty-text">还没有自己的 Prompt</view>
    <view class="empty-hint muted">把经常重复写的提示词存下来，下次直接填变量</view>
    <view class="empty-action btn" bindtap="onAddTap">新建第一条 →</view>
  </view>

  <view wx:if="{{!showAddDialog}}" class="footer-links">
    <view class="footer-link" bindtap="onGoAbout">
      <text class="link-icon">💜</text>
      <text class="link-text">关于这个小程序</text>
      <text class="link-arrow">›</text>
    </view>
    <view class="footer-link" bindtap="onGoPrivacy">
      <text class="link-icon">🔒</text>
      <text class="link-text">隐私与广告说明</text>
      <text class="link-arrow">›</text>
    </view>
  </view>

  <view wx:if="{{showAddDialog}}" class="dialog-mask" catch:tap="onCancelAdd">
    <view class="dialog" catch:tap="onDialogStop">
      <view class="dialog-title">{{editingId ? '编辑 Prompt' : '新建 Prompt'}}</view>

      <scroll-view scroll-y class="dialog-scroll">
        <view class="field-label">标题 *</view>
        <input
          class="field-input"
          value="{{newTitle}}"
          bindinput="onTitleInput"
          placeholder="例如：写 SwiftUI Todo Demo"
          placeholder-class="placeholder-grey"
          maxlength="120"
          confirm-type="next"
        />

        <view class="field-label">Prompt 内容 *</view>
        <textarea
          class="field-textarea"
          value="{{newBody}}"
          bindinput="onBodyInput"
          placeholder="写下完整提示词"
          placeholder-class="placeholder-grey"
          auto-height
          maxlength="12000"
          show-confirm-bar="{{false}}"
        />
        <view class="field-hint muted">
          变量格式：&#123;&#123;name&#125;&#125;、&#123;&#123;count:int=5&#125;&#125;、&#123;&#123;notes:multiline=&#125;&#125;
        </view>

        <view class="field-label">标签（最多 12 个）</view>
        <input
          class="field-input"
          value="{{newTags}}"
          bindinput="onTagsInput"
          placeholder="例如：iOS, SwiftUI, Demo"
          placeholder-class="placeholder-grey"
          maxlength="600"
        />
      </scroll-view>

      <view class="dialog-actions">
        <view class="dialog-btn secondary" catch:tap="onCancelAdd">取消</view>
        <view class="dialog-btn" catch:tap="onSavePrompt">{{editingId ? '保存修改' : '保存'}}</view>
      </view>
    </view>
  </view>
</view>
